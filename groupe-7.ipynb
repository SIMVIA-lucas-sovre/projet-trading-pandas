    "stock = Stock(df,'1997','2015')          # 1000 $, 0 action\n",
    "for date, history in stock.days():     # un tour de boucle par jour de cotation\n",
    "    p = history.Close\n",
    "    N1 = 5\n",
    "    N2 = 10\n",
    "    i = 0\n",
    "    Buy = True\n",
    "    Sell = True\n",
    "    if N < len(p): \n",
    "        for i in range(N1):\n",
    "            if p.iloc[-(i+1)]/p.iloc[-(i+2)]-1 > 0:\n",
    "                Buy = False\n",
    "                break\n",
    "        for i in range(N2):\n",
    "            if p.iloc[-(i+1)]/p.iloc[-(i+2)]- 1 < 0:\n",
    "                Sell = False\n",
    "                break\n",
    "    if Sell == True: \n",
    "        stock.sell()\n",
    "    if Buy == True:\n",
    "        stock.buy()\n",
    "\n",
    "stock.plot()\n"
   ]
